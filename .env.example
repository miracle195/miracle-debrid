# ---------------------------------------------------------------- networking
# Bind address. Use 127.0.0.1 if nginx/caddy sits in front on the same box.
HOST=0.0.0.0
PORT=11480

# The URL players will actually connect to. Leave blank or "auto" to automatically
# detect your local network IP (e.g. 192.168.x.x) and mDNS hostname (e.g. your-pc.local).
#   auto-detect    -> auto (default)
#   LAN            -> http://192.168.1.50:11470
#   mDNS (no-DHCP) -> http://desktop-2povfrl.local:11470
#   public + nginx -> https://debrid.example.com
PUBLIC_URL=auto

# ---------------------------------------------------------------------- auth
# Leave blank to auto-generate one into data/access-token on first boot.
ACCESS_TOKEN=
# Only set false when bound to loopback or a trusted LAN.
REQUIRE_TOKEN=true

# --------------------------------------------------------------------- paths
DATA_DIR=./data
DOWNLOAD_DIR=./data/downloads

# -------------------------------------------------------------------- addon
ADDON_ID=community.miracle.debrid
ADDON_NAME=Miracle Debrid
ADDON_VERSION=1.0.0

# ------------------------------------------------------------------ torrents
TORRENT_MAX_CONNS=60
# Bytes per second, -1 for unlimited.
DOWNLOAD_LIMIT=-1
UPLOAD_LIMIT=131072
DHT=true
# Fixed inbound port so you can forward it on the router / open it in ufw.
TORRENT_PORT=51413
# Comma-separated. Leave unset to use the built-in public tracker list.
TRACKERS=

METADATA_TIMEOUT_MS=45000
# Bytes buffered before the response starts. Raise on slow swarms.
PREBUFFER_BYTES=4MB
PREBUFFER_TIMEOUT_MS=60000
# Tear a torrent down this long after the last reader disconnects.
IDLE_TIMEOUT_MS=900000
SEED_AFTER_DOWNLOAD=false

# --------------------------------------------------------------------- cache
CACHE_MAX_BYTES=100GB
CACHE_SWEEP_INTERVAL_MS=300000
CACHE_MIN_AGE_MS=600000

# ------------------------------------------------------------------- sources
# Torznab endpoint of YOUR OWN Jackett or Prowlarr instance. Both blank = the
# torznab provider stays off and only data/sources.json is used.
#   Jackett  http://127.0.0.1:9117/api/v2.0/indexers/all/results/torznab
#   Prowlarr http://127.0.0.1:9696/api/v1/indexer/1/
TORZNAB_URL=
TORZNAB_API_KEY=

SOURCE_SEARCH_TIMEOUT_MS=12000
SOURCE_MAX_RESULTS=15

# ------------------------------------------------------------------- logging
LOG_LEVEL=info
