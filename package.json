{
  "name": "miracle-debrid",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted debrid-style service: downloads torrents and serves them as HTTP streams to Stremio-protocol apps.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node --test test/unit.test.js",
    "test:integration": "npm run build && node --test test/integration.test.js",
    "test:all": "npm run build && node --test test/unit.test.js test/integration.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "bittorrent-tracker": "^11.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
